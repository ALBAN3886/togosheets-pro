rules_version = '2';

// ═══════════════════════════════════════════════════════════════
// Règles Firestore — schéma RÉEL utilisé par index.html (MonBudget),
// public.html (Marketplace), boutique.html et employe.html (Commerce).
//
// ⚠️ Ceci remplace les règles par défaut de la console Firebase.
// Le fichier historique commerce-lot5/firebase/firestore.rules protège
// un schéma "tenants/{id}/..." qui n'est utilisé par AUCUNE page active :
// ne pas le déployer tel quel, il laisserait tout le reste sans protection.
//
// ⚠️ IMPORTANT sur employe.html : le système d'employés (tenants/{id}/
// roleBindings) n'est PAS alimenté aujourd'hui — personne n'y écrit.
// tenantId vient d'un simple paramètre d'URL (?tenant=...), donc on ne
// peut pas encore distinguer un vrai employé d'un inconnu qui devine
// l'UID du propriétaire. En attendant une vraie gestion d'employés,
// ces règles limitent l'accès à commerce_data au PROPRIÉTAIRE
// uniquement (auth.uid == tenantId). Voir la note en bas de fichier
// pour activer un accès employé réel plus tard.
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isSelf(uid)  { return isSignedIn() && request.auth.uid == uid; }

    function myUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (myUserDoc().isAdmin == true || myUserDoc().role == 'admin');
    }

    // Abonnement Commerce Premium actif pendant 30 jours.
    function tenantDoc(tenantId) {
      return get(/databases/$(database)/documents/users/$(tenantId)).data;
    }

    function isPremiumTenant(tenantId) {
      return exists(/databases/$(database)/documents/users/$(tenantId))
        && tenantDoc(tenantId).get('isPremium', false) == true
        && (
          tenantDoc(tenantId).get('premiumLifetime', false) == true
          || tenantDoc(tenantId).get('subscriptionPlan', '') == 'lifetime'
          || (
            tenantDoc(tenantId).get('premiumExpiresAt', null) != null
            && tenantDoc(tenantId).get('premiumExpiresAt', null) > request.time
          )
        );
    }

    // ── users/{uid} : profil, statut premium, flag isAdmin ──
// ── customers/{uid} : profil client ──
    match /customers/{uid} {
      allow create, read, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;

      match /cart/{cartId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      // Création du profil : impossible de devenir administrateur
      // ou Premium depuis le navigateur.
      allow create: if isSelf(uid)
                    && request.resource.data.get('isAdmin', false) == false
                    && request.resource.data.get('role', 'user') != 'admin'
                    && request.resource.data.get('isPremium', false) == false;

      // L'utilisateur peut modifier son profil, mais jamais ses droits,
      // son rôle administrateur ou son abonnement Premium.
      allow update: if (
                      isSelf(uid)
                      && request.resource.data.get('isAdmin', false)
                         == resource.data.get('isAdmin', false)
                      && request.resource.data.get('role', 'user')
                         == resource.data.get('role', 'user')
                      && request.resource.data.get('isPremium', false)
                         == resource.data.get('isPremium', false)
                      && request.resource.data.get('subscriptionPlan', 'free')
                         == resource.data.get('subscriptionPlan', 'free')
                      && request.resource.data.get('premiumExpiresAt', null)
                         == resource.data.get('premiumExpiresAt', null)
                      && request.resource.data.get('premiumLifetime', false)
                         == resource.data.get('premiumLifetime', false)
                    )
                    || isAdmin();

      allow delete: if isSelf(uid) || isAdmin();
    }

    // ── Finances personnelles (MonBudget) : un doc par opération, champ userId ──
    match /transactions/{id} {
      allow read, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /budgets/{id} {
      allow read, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /notes/{id} {
      allow read, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /sessions/{id} {
      // Journal de connexion : un utilisateur crée sa propre ligne, seul l'admin peut tout lister.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read:   if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list:   if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /salary_config/{uid} {
      allow read, write: if isSelf(uid) || isAdmin();
    }

    match /premiumRequests/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read:   if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list, update, delete: if isAdmin();
    }

    // ── Chat support/vendeur ──
    // Le chat client reste accessible même sans compte Firebase.
    match /chats_flat/{id} {
      allow read, write: if true;
    }

    // ── Liaisons employés : seul le propriétaire peut gérer ses employés ──
    match /tenants/{tenantId}/roleBindings/{employeeUid} {
      allow read: if isSignedIn()
        && (request.auth.uid == tenantId
            || request.auth.uid == employeeUid
            || isAdmin());

      allow create, update, delete: if isSignedIn()
        && (request.auth.uid == tenantId || isAdmin());
    }

    // ── Commerce : propriétaire OU employé autorisé par roleBinding ──
    match /commerce_data/{tenantId} {
      allow read, write: if isAdmin()
        || (
          isPremiumTenant(tenantId)
          && (
            isSelf(tenantId)
            || (
              isSignedIn()
              && exists(/databases/$(database)/documents/tenants/$(tenantId)/roleBindings/$(request.auth.uid))
              && get(/databases/$(database)/documents/tenants/$(tenantId)/roleBindings/$(request.auth.uid)).data.active == true
            )
          )
        );
    }

    // ── Vitrine publique de chaque boutique (lecture publique, écriture propriétaire) ──
    // ── AET-PATCH-20260920 : profil utilisateur (index.html : loadProfile / saveProfileEdit) ──
    match /profiles/{uid} {
      allow read, write: if isSelf(uid) || isAdmin();
    }

    // Historique de profil : addDoc() => ID automatique + champ userId (jamais modifiable/supprimable).
    match /profileHistory/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ── AET-PATCH-20260920 : Commerce Pro (clients, fournisseurs, crédits, caisse, inventaires) ──
    match /commerce_pro_data/{uid} {
      allow read, write: if isAdmin()
        || (isSelf(uid) && isPremiumTenant(uid));
    }

    match /public_shops/{tenantId} {
      allow read: if true;
      allow write: if isAdmin()
        || (isSelf(tenantId) && isPremiumTenant(tenantId));
    }

    // ── Lien personnalisé de boutique (ex: /togosheets-marketplace/aetshop) ──
    // Le document lui-même ne contient que la référence vers le vrai tenant/store :
    // {tenantId, storeId}. Lecture publique (nécessaire pour résoudre le lien avant même
    // que le visiteur soit identifié), écriture réservée au propriétaire de ce tenantId.
    match /shop_slugs/{slug} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.tenantId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.tenantId == request.auth.uid || isAdmin();
    }

    // ── Commandes marketplace : créées par n'importe quel acheteur, lues par le vendeur/l'admin ──
    match /public_orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['tenantId'])
                    && request.resource.data.tenantId is string;

      allow read: if isSignedIn()
        && (
          resource.data.tenantId == request.auth.uid
          || resource.data.get('buyerId', null) == request.auth.uid
          || isAdmin()
          || (
            exists(/databases/$(database)/documents/tenants/$(resource.data.tenantId)/roleBindings/$(request.auth.uid))
            && get(/databases/$(database)/documents/tenants/$(resource.data.tenantId)/roleBindings/$(request.auth.uid)).data.active == true
          )
        );

      allow list: if isSignedIn()
        && (
          isAdmin()
          || resource.data.tenantId == request.auth.uid
          || resource.data.get('buyerId', null) == request.auth.uid
          || (
            exists(/databases/$(database)/documents/tenants/$(resource.data.tenantId)/roleBindings/$(request.auth.uid))
            && get(/databases/$(database)/documents/tenants/$(resource.data.tenantId)/roleBindings/$(request.auth.uid)).data.active == true
          )
        );

      allow update, delete: if isSignedIn()
        && (
          resource.data.tenantId == request.auth.uid
          || isAdmin()
          || (
            exists(/databases/$(database)/documents/tenants/$(resource.data.tenantId)/roleBindings/$(request.auth.uid))
            && get(/databases/$(database)/documents/tenants/$(resource.data.tenantId)/roleBindings/$(request.auth.uid)).data.active == true
          )
        );
    }
  }
}
